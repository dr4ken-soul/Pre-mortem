{
  "name": "premortem",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch server/index.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node dist-server/server/index.js",
    "server:build": "tsc -p tsconfig.server.json",
    "check": "tsc -b --pretty false",
    "test": "vitest run server/api.smoke.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^8.2.0",
    "@fontsource/barlow": "^5.2.5",
    "@fontsource/fraunces": "^5.2.5",
    "@fontsource/space-mono": "^5.2.5",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-query": "^5.83.0",
    "dotenv": "^16.5.0",
    "elevenlabs": "^1.59.0",
    "ethers": "^6.15.0",
    "fastify": "^5.4.0",
    "lru-cache": "^11.1.0",
    "motion": "^12.23.12",
    "node-fetch": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "satori": "^0.12.2",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "~5.7.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
